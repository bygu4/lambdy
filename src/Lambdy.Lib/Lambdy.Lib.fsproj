<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Tailcalls>true</Tailcalls>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Continuation.fs" />
    <Compile Include="Literals.fs" />
    <Compile Include="ParseTree.fs" />
    <Compile Include="Parsers.fs" />
    <Compile Include="IR.fs" />
    <Compile Include="AST.fs" />
    <Compile Include="LambdaTerm.fs" />
    <Compile Include="Strategy.fs" />
    <Compile Include="Interfaces/IReducer.fs" />
    <Compile Include="Interfaces/ILambdaInterpreter.fs" />
    <Compile Include="Interfaces/ILogger.fs" />
    <Compile Include="Reducer.fs" />
    <Compile Include="LambdaInterpreter.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="fparsec" Version="1.1.1" />
  </ItemGroup>

</Project>
